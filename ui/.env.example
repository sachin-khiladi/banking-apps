# ── Banking UI — environment variables ────────────────────────────────────────
# Copy this file to .env.local and fill in the values for local development.
# Never commit .env.local to source control.

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# ── Azure AD B2C ──────────────────────────────────────────────────────────────
# Azure AD B2C tenant name (e.g., myb2ctenant).
VITE_B2C_TENANT_NAME=

# Azure AD B2C client (application) ID.
VITE_B2C_CLIENT_ID=

# B2C sign-in / sign-up user flow name (e.g., B2C_1_signupsignin).
VITE_B2C_SUSI_FLOW=B2C_1_signupsignin

# Redirect URI after authentication (must match the app registration).
VITE_REDIRECT_URI=http://localhost:3000

# ── API scopes ────────────────────────────────────────────────────────────────
# Expose API scope for the backend (e.g., https://<tenant>.onmicrosoft.com/<api-client-id>/access_as_user).
VITE_API_SCOPE=

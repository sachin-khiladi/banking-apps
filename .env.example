# ── Banking System API — environment variables ────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# Never commit .env to source control.

# ── CosmosDB (required for account endpoints) ─────────────────────────────────
# The HTTPS endpoint of your Cosmos DB account.
# Leave blank to run the app without a database (health endpoint still works;
# account endpoints return 500 until these are set).
COSMOS_ACCOUNT_URL=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_DB_NAME=bankingdb

# ── JWT authentication ────────────────────────────────────────────────────────
# Set a long random string in production (e.g. openssl rand -hex 32).
# The default "local-dev-insecure-secret" is ONLY for local development.
JWT_SECRET_KEY=local-dev-insecure-secret

# Optional: token lifetime in minutes (default: 30)
JWT_EXPIRE_MINUTES=30

# ── Azure Application Insights (optional locally) ────────────────────────────
# When absent, the app falls back to stdout logging only.
# Format: InstrumentationKey=<key>;IngestionEndpoint=<url>
APPLICATIONINSIGHTS_CONNECTION_STRING=
